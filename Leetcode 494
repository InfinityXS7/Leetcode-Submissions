    int findTargetSumWays(vector<int>& nums, int target) {
        int ans = 0;
        int n = nums.size();
        // solve(nums, target, n, 0, ans);

        int tsum=0;
        for(int x:nums){
            tsum+=x;
        }
        if(abs(target)>tsum || (tsum-target)%2!=0){
            return 0;
        }
        int newTarget=(tsum-target)/2;
        vector<vector<int>>dp(n+1,vector<int>(newTarget+1,0));
        dp[n][0]=1;
        for(int i=n-1;i>=0;i--){
            for(int j=0;j<=newTarget;j++){
                int notake=dp[i+1][j];
                int take=0;
                if(j-nums[i]>=0){
                    take=dp[i+1][j-nums[i]];
                }
                dp[i][j]=take+notake;
            }
        }
        return dp[0][newTarget];
    }
