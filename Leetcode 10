    bool isMatch(string s, string p) {
        int n = s.size();
        int m = p.size();
        vector<vector<bool>> dp(n+1, vector<bool>(m+1, false));
        dp[0][0] = true;
        // Handle empty string
        for(int j = 2; j <= m; j++) {
            if(p[j-1] == '*') {
                dp[0][j] = dp[0][j-2];
            }
        }
        for(int i = 1; i <= n; i++) {
            for(int j = 1; j <= m; j++) {
                if(s[i-1] == p[j-1] || p[j-1] == '.') {
                    dp[i][j] = dp[i-1][j-1];
                }
                else if(p[j-1] == '*') {
                    bool zero = dp[i][j-2];
                    bool one = false;
                    if(s[i-1] == p[j-2] || p[j-2] == '.') {
                        one = dp[i-1][j];
                    }
                    dp[i][j] = zero || one;
                }
                else {
                    dp[i][j] = false;
                }
            }
        }
        return dp[n][m];
    }
