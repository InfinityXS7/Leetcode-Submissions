    int jump(vector<int>& nums) {
        int n=nums.size();
        vector<int>dp(n,INT_MAX);
        dp[n-1]=0;
        for(int i=n-2;i>=0;i--){
            for(int j=1;j<=nums[i];j++){
                if(i+j<n&&dp[i+j]!=INT_MAX){
                    dp[i]=min(dp[i],1+dp[i+j]);
                }
            }
        }
        return dp[0];
    }
