// when highly skewed it caused dthe recursion call stack to become very large hence use the iterative approach

class Solution {
public:
    vector<int> findSubtreeSizes(vector<int>& parent, string s) {
        int n = s.size();
        vector<vector<int>> adj(n);
        for(int i = 1; i < n; i++){
            adj[parent[i]].push_back(i);
        }
        vector<int> last(26, -1);
        vector<int> newParent(n, -1);
        vector<int> prevLast(n, -1);
        stack<pair<int, int>> st;
        st.push({0, 0});
        while(!st.empty()){
            auto [u, state] = st.top();
            st.pop();
            int c = s[u] - 'a';
            if(state == 0){
                prevLast[u] = last[c];
                if(last[c] != -1){
                    newParent[u] = last[c];
                }
                else{
                    newParent[u] = parent[u];
                }
                last[c] = u;
                st.push({u, 1});
                for(int i = adj[u].size() - 1; i >= 0; i--){
                    st.push({adj[u][i], 0});
                }
            }
            else{
                last[c] = prevLast[u];
            }
        }
        vector<vector<int>> newAdj(n);
        for(int i = 1; i < n; i++){
            newAdj[newParent[i]].push_back(i);
        }
        vector<int> order;
        stack<int> temp;
        temp.push(0);
        while(!temp.empty()){
            int u = temp.top();
            temp.pop();
            order.push_back(u);
            for(int v : newAdj[u]){
                temp.push(v);
            }
        }
        vector<int> ans(n, 1);
        for(int i = n - 1; i >= 1; i--){
            int u = order[i];
            ans[newParent[u]] += ans[u];
        }
        return ans;
    }
};
