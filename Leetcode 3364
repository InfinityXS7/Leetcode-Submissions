class Solution {
public:
    int minimumSumSubarray(vector<int>& nums, int l, int r) {
        int ans = INT_MAX;
        int n = nums.size();
        // for(int i=0;i<n;i++){
        //     int sum=0;
        //     for(int j=i;j<n && j-i+1<=r;j++){
        //         sum+=nums[j];
        //         int len=j-i+1;
        //         if(len>=l && sum>0){
        //             ans=min(ans,sum);
        //         }
        //     }
        // }

        for(int k=l;k<=r;k++){
            int sum=0;
            for(int i=0;i<k;i++){
                sum+=nums[i];
            }
            if(sum>0){
                ans=min(ans,sum);
            }
            for(int i=k;i<n;i++){
                sum+=nums[i];
                sum-=nums[i-k];

                if(sum>0){
                    ans=min(ans,sum);
                }
            }
        }
        return ans==INT_MAX ? -1 : ans;
    }
};
