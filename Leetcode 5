    string longestPalindrome(string s) {
        int n=s.size();
        if(n==0){
            return "";
        }
        st=0;
        len=1;
        vector<vector<int>>dp(n,vector<int>(n,-1));
        for(int i=0;i<n;i++){
            for(int j=i;j>=0;j--){
                dp[i][j]=1;
            }
        }
        for(int i=n-1;i>=0;i--){
            for(int j=i+1;j<n;j++){
                if(s[i]==s[j]){
                    if(j-i==1||dp[i+1][j-1]==1){
                        dp[i][j]=1;
                    }
                }
                if(dp[i][j]==1&&j-i+1>len){
                    len=j-i+1;
                    st=i;
                }
            }
        }
        // solve(s,0,n-1,n,dp);
        return s.substr(st,len);
    }
