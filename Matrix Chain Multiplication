    int matrixMultiplication(vector<int>& arr) {
        int n = arr.size();

        vector<vector<int>> dp(n, vector<int>(n, INT_MAX));
        for(int i=1; i<n; i++) {
                    dp[i][i] = 0;  
                }
        for(int i=n-1; i>=1; i--) {
            for(int j=i+1; j<n; j++) {
                for(int k=i; k<j; k++) {
                    int cost = dp[i][k] + dp[k+1][j]
                                + arr[i-1]*arr[k]*arr[j];
                            dp[i][j] = min(dp[i][j], cost);
                        }
                    }
                }

                return dp[1][n-1];
    }
