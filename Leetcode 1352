
class ProductOfNumbers {
public:
    vector<int>prod;
    ProductOfNumbers() {
        prod.push_back(1);
    }
    
    void add(int num) {
        if(num==0){
            prod.clear();
            prod.push_back(1);
            return;
        }
        prod.push_back(prod.back()*num);
    }
    
    int getProduct(int k) {
        if(k>=prod.size()){
            return 0;
        }
        return prod[prod.size()-1]/prod[prod.size()-k-1];
    }
};

